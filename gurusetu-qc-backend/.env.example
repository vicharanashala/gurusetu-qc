PORT=4187
NODE_ENV=production
MONGODB_URI=mongodb://user:pass@127.0.0.1:27017/gurusetu?authSource=gurusetu
UPLOAD_DIR=/var/gurusetu/server/uploads
TEMP_DIR=/var/gurusetu/server/temp

# ---- Authentication (required) ----------------------------------------------
# Signs session JWTs. Rotating it logs everyone out.
JWT_SECRET=generate-with-openssl-rand-hex-32
# Wraps provider API keys before they are written to Mongo. Rotating it makes
# every stored key undecryptable — they must be re-entered in Settings.
ENCRYPTION_KEY=generate-with-openssl-rand-hex-32
ADMIN_USERNAME=admin
SESSION_HOURS=12
# Set to false only when serving over plain HTTP locally.
COOKIE_SECURE=true

# There is no registration route. Create/reset the admin credential with:
#   npm run set-password

# ---- LLM provider ------------------------------------------------------------
# These are only SEED values, applied once on first boot to populate the
# database-backed config. After that, the admin manages the provider, base URL,
# model and API key in the UI under Settings -> LLM provider.
# LLM_PROVIDER: anthropic | openai | mock   ('minimax' is accepted as anthropic)
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ---- Transcription (Whisper) -------------------------------------------------
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1

# ---- Media tooling -----------------------------------------------------------
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg

MAX_UPLOAD_MB=500
MAX_TRANSCRIPT_CHARS=180000
